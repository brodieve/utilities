{
  "MetricAlarms": [
    {
      "AlarmName": "price-poller-error-rate",
      "AlarmDescription": "Poller error rate above threshold",
      "Namespace": "PriceOracle",
      "MetricName": "PollerErrors",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 1,
      "Threshold": 5.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "missing",
      "ActionsEnabled": true
    }
  ]
}
